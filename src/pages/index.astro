---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form
        id="game-filters"
        class="mb-8 grid gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-6 md:grid-cols-[1fr_1fr_auto]"
        aria-label="Filter games"
      >
        <div>
          <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Categories</label>
          <select
            id="category-filter"
            name="category"
            multiple
            size={Math.min(Math.max(categories.length, 2), 5)}
            data-testid="category-filter"
            class="min-h-24 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            aria-describedby="category-filter-help"
          >
            {categories.map((category) => <option value={category.id}>{category.name}</option>)}
          </select>
          <p id="category-filter-help" class="mt-2 text-xs text-slate-400">Use Ctrl or Command to select multiple.</p>
        </div>

        <div>
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            name="publisher"
            data-testid="publisher-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
          </select>
        </div>

        <div class="flex items-end gap-3">
          <button
            type="submit"
            data-testid="apply-filters"
            class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            Apply filters
          </button>
          <a
            href="/"
            data-testid="clear-filters"
            class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            Clear
          </a>
        </div>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div id="games-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div id="filtered-empty-state" data-testid="filtered-empty-state" class="hidden">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#game-filters');
  const categoryFilter = document.querySelector<HTMLSelectElement>('#category-filter');
  const publisherFilter = document.querySelector<HTMLSelectElement>('#publisher-filter');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const emptyState = document.querySelector<HTMLElement>('#filtered-empty-state');
  const gamesGrid = document.querySelector<HTMLElement>('#games-grid');

  if (form && categoryFilter && publisherFilter && emptyState && gamesGrid) {
    const selectedCategories = new Set(new URLSearchParams(window.location.search).getAll('category'));
    const selectedPublisher = new URLSearchParams(window.location.search).get('publisher') ?? '';

    for (const option of categoryFilter.options) {
      option.selected = selectedCategories.has(option.value);
    }
    publisherFilter.value = selectedPublisher;

    const applyFilters = (url: URL): void => {
      const categories = new Set(url.searchParams.getAll('category'));
      const publisher = url.searchParams.get('publisher');
      let visibleCount = 0;

      for (const card of cards) {
        const categoryMatches = categories.size === 0 || categories.has(card.dataset.categoryId ?? '');
        const publisherMatches = !publisher || publisher === (card.dataset.publisherId ?? '');
        const visible = categoryMatches && publisherMatches;
        card.hidden = !visible;
        visibleCount += visible ? 1 : 0;
      }

      gamesGrid.hidden = visibleCount === 0;
      emptyState.classList.toggle('hidden', visibleCount > 0);
    };

    applyFilters(new URL(window.location.href));

    form.addEventListener('submit', (event): void => {
      event.preventDefault();
      const url = new URL(window.location.href);
      const searchParams = new URLSearchParams();
      for (const [key, value] of new FormData(form).entries()) {
        searchParams.append(key, String(value));
      }
      url.search = searchParams.toString();
      window.history.pushState({}, '', url);
      applyFilters(url);
    });

    window.addEventListener('popstate', (): void => {
      const url = new URL(window.location.href);
      for (const option of categoryFilter.options) {
        option.selected = url.searchParams.getAll('category').includes(option.value);
      }
      publisherFilter.value = url.searchParams.get('publisher') ?? '';
      applyFilters(url);
    });
  }
</script>
